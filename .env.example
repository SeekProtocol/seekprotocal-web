# Copy to .env.local. Anything prefixed NEXT_PUBLIC_ ships to the browser.

# Forms (contact, beta). See README, "Environment".
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics, loaded only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shop (/shop). The app's own Supabase project: the anon key is the value of
# EXPO_PUBLIC_SUPABASE_ANON_KEY in the app repo's .env. The RPC is asked for a
# recent blockhash only; its host must also appear in the CSP connect-src in
# vercel.json, so change both together.
NEXT_PUBLIC_SUPABASE_URL=https://ukoqxyoogjouhdqhtiei.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
